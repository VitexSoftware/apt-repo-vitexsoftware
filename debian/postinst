#!/bin/sh
# postinst script for apt-repo-vitexsoftware
#
# see: dh_installdeb(1)

set -e

. /usr/share/debconf/confmodule

#DEBHELPER#

case "$1" in
    configure)
        CODENAME=$(lsb_release -sc)
        SOURCES=/etc/apt/sources.list.d/vitexsoftware.sources

        db_get apt-repo-vitexsoftware/components
        # debconf multiselect returns "main, backports, games" — convert to space-separated
        COMPONENTS=$(echo "$RET" | sed 's/, / /g; s/,/ /g')

        db_get apt-repo-vitexsoftware/borrow
        BORROW="$RET"

        > "$SOURCES"

        if [ -n "$COMPONENTS" ]; then
            cat >> "$SOURCES" <<EOF
Types: deb
URIs: https://repo.vitexsoftware.com/
Suites: ${CODENAME}
Components: ${COMPONENTS}
Signed-By: /usr/share/keyrings/vitexsoftware.gpg
EOF
        fi

        if [ "$BORROW" = "true" ]; then
            [ -n "$COMPONENTS" ] && echo >> "$SOURCES"
            cat >> "$SOURCES" <<EOF
Types: deb
URIs: https://repo.vitexsoftware.com/
Suites: borrow
Components: main ${CODENAME}-mained
Signed-By: /usr/share/keyrings/vitexsoftware.gpg
EOF
        fi

        DEBIAN_FRONTEND=noninteractive apt-get update || true
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
